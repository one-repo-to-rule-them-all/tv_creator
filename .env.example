# ─── ErsatzTV host ────────────────────────────────────────────────────────────
# URL where ErsatzTV is reachable (no trailing slash)
ETV_HOST=http://localhost:8409

# Port mapping for docker-compose (host side)
ETV_PORT=8409

# ─── Database path ────────────────────────────────────────────────────────────
# Path to the ErsatzTV SQLite database on the HOST machine.
#
# Docker (default): the config volume is at ./ersatztv-config relative to this
# repo, so the DB is at ./ersatztv-config/ersatztv.sqlite3. Leave this unset
# and setup.py will find it automatically.
#
# Native ErsatzTV on Windows: uncomment and set to the AppData path.
# ETV_DB_PATH=C:\Users\YourName\AppData\Local\ersatztv\ersatztv.sqlite3

# ─── Media paths ──────────────────────────────────────────────────────────────
# Base path where ErsatzTV will look for media files.
#
# This must be the path AS SEEN FROM INSIDE THE CONTAINER (Docker) or
# from the ErsatzTV process (native).
#
# Docker: /nas  (the NAS share is mounted at /nas inside the container)
# Native: Z:/   (NAS mapped as Z: drive on Windows)
NAS_CONTAINER_PATH=/nas

# The host-side NAS path for docker-compose bind mount.
# Docker Desktop on Windows cannot mount UNC paths (\\server\share) directly.
# Option A: map the share to a drive letter (e.g. Z:) and mount that.
# Option B: run ErsatzTV natively (no Docker) and set NAS_CONTAINER_PATH=Z:
NAS_HOST_PATH=//wdmycloud/public

# Where ErsatzTV stores its config/database (host path, Docker only)
ETV_CONFIG_PATH=./ersatztv-config

# ─── Timezone ─────────────────────────────────────────────────────────────────
# Full tz database name — https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Chicago

# ─── Channel settings ─────────────────────────────────────────────────────────
CHANNEL_NUMBER=2
CHANNEL_NAME=My Media
CHANNEL_GROUP=IPTV

# ─── Schedule settings ────────────────────────────────────────────────────────
SCHEDULE_NAME=My Media Schedule

# ─── Collection settings ──────────────────────────────────────────────────────
COLLECTION_NAME=All My Media
