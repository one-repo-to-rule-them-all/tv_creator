# ─── ErsatzTV host ────────────────────────────────────────────────────────────
# URL where ErsatzTV is reachable (no trailing slash)
ETV_HOST=http://localhost:8409

# Port mapping for docker-compose (host side)
ETV_PORT=8409

# ─── Paths ────────────────────────────────────────────────────────────────────
# Absolute path to your media root on the HOST machine.
# IMPORTANT: this same path is mounted into the container, so the path you
# tell ErsatzTV (in setup.py) must match EXACTLY what the container sees.
# Example: /mnt/nas/media  or  /home/rodolfo/Videos
MEDIA_PATH=/path/to/your/media

# Sub-paths inside MEDIA_PATH for each library type (relative to MEDIA_PATH).
# Leave blank to skip that library type.
MOVIES_SUBPATH=Movies
SHOWS_SUBPATH=Shows
# MUSIC_VIDEOS_SUBPATH=MusicVideos
# OTHER_VIDEOS_SUBPATH=OtherVideos

# Where ErsatzTV stores its config database (host path)
ETV_CONFIG_PATH=./ersatztv-config

# ─── Timezone ─────────────────────────────────────────────────────────────────
# Full tz database name — https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Chicago

# ─── Channel settings ─────────────────────────────────────────────────────────
CHANNEL_NUMBER=1
CHANNEL_NAME=My Media
CHANNEL_GROUP=IPTV

# ─── Schedule settings ────────────────────────────────────────────────────────
SCHEDULE_NAME=My Media Schedule

# ─── Collection settings ──────────────────────────────────────────────────────
COLLECTION_NAME=All My Media
